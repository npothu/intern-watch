# Copy to .env (gitignored) and fill in. In GitHub Actions these are provided
# as repository secrets of the same name and wired into a workflow's `env:` block
# (see docs/browserbase.md). Never commit real values.

# --- Browserbase (hosted browser; required for provider: browserbase) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Model key for AI browser automation (Stagehand) ---
# Reuse GEMINI_API_KEY as the model key, or set MODEL_API_KEY explicitly.
GEMINI_API_KEY=
# MODEL_API_KEY=

# --- Email (verification links / OTP polling, notifications) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# jobright.ai login (optional: resolve matches to the real employer apply URL)
JOBRIGHT_EMAIL=
JOBRIGHT_PASSWORD=

# --- Convex store (optional; STORE=convex) ---
# Human state (applied/saved/dismissed ticks, the applications ledger, and
# the match snapshot) normally lives in the GitHub issue + committed state.
# Set STORE=convex to serve it from a Convex deployment instead (see README
# "Database backend"): CONVEX_URL is the deployment origin and CONVEX_SECRET
# must equal the deployment's TRACKER_SECRET env var. Every mutation checks
# it. Leave both blank (and STORE unset) to keep the default GitHub driver.
STORE=github
CONVEX_URL=
CONVEX_SECRET=

# --- Convex admin key (the web app's Google setup wizard) ---
# Set on the WEB app (Vercel / web/.env.local), not on the Convex deployment.
# Lets the wizard write GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET /
# MAIL_PUBSUB_TOPIC / MAIL_PUSH_TOKEN straight to the deployment instead of
# making you run `npx convex env set` by hand.
#
# This key can set ANY environment variable on the deployment, so
# web/lib/convex-admin.ts allows exactly those four names and exposes no
# generic setter and no getter. Do not widen that allowlist casually:
# overwriting CREDENTIALS_KEY would make every stored credential permanently
# undecryptable, and overwriting TRACKER_SECRET would lock out the pipeline.
# Leave unset to disable the wizard's write path (it then degrades to showing
# the values and telling you to set them yourself).
# CONVEX_ADMIN_KEY=

# --- Per-user credentials (the web app's Connections page) ---
# Set ON THE CONVEX DEPLOYMENT, not here, with:
#   npx convex env set CREDENTIALS_KEY "$(openssl rand -base64 32)"
# 32 random bytes, base64. Every row in the `credentials` table is AES-256-GCM
# ciphertext under this key, so rotating it makes every stored credential
# undecryptable and users have to re-enter them. There is no key history.
# CREDENTIALS_KEY=
#
# Note on GEMINI_API_KEY above: once the Connections page is in use, the key
# that matters is the per-user one in the `credentials` table. The deployment
# value is NOT a fallback - a user without their own key has LLM steps skipped
# rather than quietly spending someone else's quota. Keep it set only for the
# standalone Python pipeline runs that predate per-user credentials.

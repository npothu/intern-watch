# Copy to .env (gitignored) and fill in. In GitHub Actions these are provided
# as repository secrets of the same name and wired into a workflow's `env:` block
# (see docs/browserbase.md). Never commit real values.
#
# Tiers: REQUIRED is the minimum for a working watcher. Everything below the
# REQUIRED block is OPTIONAL -- the watcher runs without any of it.
# `python -m src.config_check` prints the per-feature ENABLED/DISABLED status
# and the exact vars each disabled feature needs.
# Where users/, state/, resumes/ and out/ live when they are kept in a
# separate private data repo (see README "Separate data repo"). Blank = here.
INTERN_WATCH_DATA_DIR=

# --- REQUIRED: the watcher's email sender + LLM classifier key ---------------
# The email channel also doubles as auto-apply's inbox (verification links /
# OTP polling), and GMAIL_APP_PASSWORD is the apply inbox password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# The LLM key for the shipped llm config (llm.provider: gemini). The watcher
# needs it for term / company / Atlanta judgments. A fork that wants no LLM
# calls disables llm.enabled and sets unknown_term_policy: drop instead.
GEMINI_API_KEY=

# --- Optional: jobright.ai login ---------------------------------------------
# Resolves accepted matches whose link is still a jobright URL to the real
# employer apply URL (logged-in swan endpoint; session cookies persist via an
# Actions cache). Without them the watcher keeps the jobright link.
JOBRIGHT_EMAIL=
JOBRIGHT_PASSWORD=

# --- Optional: Convex store (STORE=convex) -----------------------------------
# Human state (applied/saved/dismissed ticks, the applications ledger, and
# the match snapshot) normally lives in the GitHub issue + committed state.
# Set STORE=convex to serve it from a Convex deployment instead (see README
# "Database backend"): CONVEX_URL is the deployment origin and CONVEX_SECRET
# must equal the deployment's TRACKER_SECRET env var. Every mutation checks
# it. Leave both blank (and STORE unset) to keep the default GitHub driver.
STORE=github
CONVEX_URL=
CONVEX_SECRET=

# --- Optional: auto-apply cloud browser (Browserbase) -------------------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Model key for AI browser automation (Stagehand); the LLM agent reuses the
# watcher's GEMINI_API_KEY above, or set MODEL_API_KEY explicitly.
# MODEL_API_KEY=

# --- Optional: standalone CLI mail authorization -----------------------------
# These local values are used by `python -m src.mail_auth`.
# The hosted web flow uses the deployment-wide Web application OAuth client
# configured separately in Convex. See docs/mail-sync.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Optional: per-user credentials (the web app's Connections page) ---------
# Set ON THE CONVEX DEPLOYMENT, not here, with:
#   npx convex env set CREDENTIALS_KEY "$(openssl rand -base64 32)"
# 32 random bytes, base64. Every row in the `credentials` table is AES-256-GCM
# ciphertext under this key, so rotating it makes every stored credential
# undecryptable and users have to re-enter them. There is no key history.
# CREDENTIALS_KEY=
#
# Note on GEMINI_API_KEY above: once the Connections page is in use, the key
# that matters is the per-user one in the `credentials` table. The deployment
# value is NOT a fallback - a user without their own key has LLM steps skipped
# rather than quietly spending someone else's quota. Keep it set only for the
# standalone Python pipeline runs that predate per-user credentials.

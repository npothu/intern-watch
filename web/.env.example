# Copy to web/.env.local and fill in real values. Never commit real values.
# These are the hosted web app's variables only - the Python pipeline has its
# own root .env.example. GitHub Actions builds (web-ci.yml) provide dummies of
# the same names so `next build` can run without real secrets.

# --- Clerk auth (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Convex store (shared with the Python pipeline; STORE=convex) ---
# CONVEX_URL is the deployment origin; CONVEX_SECRET must equal the
# deployment's TRACKER_SECRET env var. Server-only, never exposed client-side.
CONVEX_URL=https://YOUR_DEPLOYMENT.convex.site
CONVEX_SECRET=dummy-convex-secret

# --- User mapping ---
# JSON object mapping each authorized Clerk email to its tracker user key.
TRACKER_USER_MAP={"you@example.com":"example"}

# --- Admin users (server-only) ---
# Comma-separated tracker user keys allowed to write deployment-wide config:
# the Google wizard's GMAIL_* / MAIL_* env vars, which are shared by every
# user of the deployment. UNSET deliberately means single-user - the signed-in
# user is implicitly the admin, so a solo self-hoster is never locked out of
# their own wizard. Once real users are hosted, set it to the keys that may
# touch the shared vars, e.g. "you,other-admin".
ADMIN_TRACKER_USERS=

# --- On-demand resume build (server-only) ---
# Resume builds run inside Convex (convex/resume.ts). Nothing is required in
# this file for resume building beyond CONVEX_URL / CONVEX_SECRET above - the
# web server simply calls the `resume:requestBuild` mutation /
# `resume:getBuildStatus` query.
#
# The tailoring pass reads each user's OWN Gemini key, saved on the in-app
# Settings > Connections page and stored encrypted per user. A deployment-level
# GEMINI_API_KEY env var does NOT feed it - see the note on resolveGeminiKey in
# convex/credentials.ts for why there is no fallback. Without a key of their
# own, a user's builds still succeed and simply use the bullet bank verbatim,
# which the build report states outright.

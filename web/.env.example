# Copy to web/.env.local and fill in real values. Never commit real values.
# These are the hosted web app's variables only - the Python pipeline has its
# own root .env.example. GitHub Actions builds (web-ci.yml) provide dummies of
# the same names so `next build` can run without real secrets.

# --- Clerk auth (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Convex store (shared with the Python pipeline; STORE=convex) ---
# CONVEX_URL is the deployment origin; CONVEX_SECRET must equal the
# deployment's TRACKER_SECRET env var. Server-only, never exposed client-side.
CONVEX_URL=https://YOUR_DEPLOYMENT.convex.site
CONVEX_SECRET=dummy-convex-secret

# --- User mapping ---
# JSON object mapping each authorized Clerk email to its tracker user key.
TRACKER_USER_MAP={"you@example.com":"example"}

# --- On-demand resume build (server-only) ---
# Resume builds run inside Convex (convex/resume.ts). The build action needs
# the Gemini API key as a SECOND Convex deployment env var (GEMINI_API_KEY);
# set it in the Convex dashboard, not here. Nothing is required in this file
# for resume building beyond CONVEX_URL / CONVEX_SECRET above - the web server
# simply calls the `resume:requestBuild` mutation / `resume:getBuildStatus`
# query. If the web app has no GEMINI_API_KEY set here, builds still run, using
# the deployment's own GEMINI_API_KEY.

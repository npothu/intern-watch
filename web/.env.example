# Copy to web/.env.local and fill in real values. Never commit real values.
# These are the hosted web app's variables only - the Python pipeline has its
# own root .env.example. GitHub Actions builds (web-ci.yml) provide dummies of
# the same names so `next build` can run without real secrets.

# --- Clerk auth (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Convex store (shared with the Python pipeline; STORE=convex) ---
# CONVEX_URL is the deployment origin; CONVEX_SECRET must equal the
# deployment's TRACKER_SECRET env var. Server-only, never exposed client-side.
CONVEX_URL=https://YOUR_DEPLOYMENT.convex.site
CONVEX_SECRET=dummy-convex-secret

# --- User mapping ---
# JSON object mapping each authorized Clerk email to its tracker user key.
TRACKER_USER_MAP={"you@example.com":"example"}

# --- Admin users (server-only) ---
# Comma-separated tracker user keys allowed to write deployment-wide config:
# the Google wizard's GMAIL_* / MAIL_* env vars, which are shared by every
# user of the deployment. UNSET deliberately means single-user - the signed-in
# user is implicitly the admin, so a solo self-hoster is never locked out of
# their own wizard. Once real users are hosted, set it to the keys that may
# touch the shared vars, e.g. "you,other-admin".
ADMIN_TRACKER_USERS=

# --- Connect Google in the browser (server-only) ---
# Only needed if you want the Settings wizard's "Sign in with Google" button.
# Without these the wizard falls back to `python -m src.mail_auth`, names the
# variable that is missing, and everything else keeps working.
#
# CONVEX_SITE_URL is the origin that serves Convex HTTP actions, which is NOT
# the client API origin: *.convex.site, not *.convex.cloud. The OAuth callback
# and the Gmail push endpoint both live there, and the redirect URI you register
# in Google Cloud must be exactly <CONVEX_SITE_URL>/gmail/callback - character
# for character, no trailing slash. It is inferred from CONVEX_URL for a cloud
# deployment; set it explicitly for a custom domain or a local backend, where
# the API and site origins sit on different ports.
CONVEX_SITE_URL=
#
# APP_ORIGIN is this app's own public origin, e.g. https://jobs.example.com.
# The consent flow signs a state containing the origin to return to, and the
# callback redirects there. Left unset it is taken from the request's Host
# header, which a caller can forge - pinning it means a forged Host cannot turn
# our own signature into an endorsement of someone else's domain.
APP_ORIGIN=
#
# The Google client ID and secret are NOT set here. They live on the Convex
# deployment (`npx convex env set --prod GMAIL_CLIENT_ID ...`), which is where
# the wizard writes them and where the token exchange reads them. The web app
# reads the id back through Convex, so there is one copy, not two.

# --- On-demand resume build (server-only) ---
# Resume builds run inside Convex (convex/resume.ts). Nothing is required in
# this file for resume building beyond CONVEX_URL / CONVEX_SECRET above - the
# web server simply calls the `resume:requestBuild` mutation /
# `resume:getBuildStatus` query.
#
# The tailoring pass prefers each user's OWN key, saved on the in-app
# Settings > Connections page and stored encrypted per user (Gemini, Anthropic,
# OpenAI or OpenRouter). A user who has not set one falls back to the
# deployment's shared key, under a per-user daily cap - so set GEMINI_API_KEY
# on the CONVEX deployment (`npx convex env set GEMINI_API_KEY ...`, not in
# this file) if you want tailoring to work with nothing for users to configure.
# With neither key, builds still succeed and use the bullet bank verbatim,
# which the build report states outright.
